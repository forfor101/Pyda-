# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL NOTIFICATION SERVICE CONFIGURATION
# Optional: Provide Resend API key for Resend dispatch
RESEND_API_KEY=

# Optional: Provide SendGrid API key for SendGrid dispatch
SENDGRID_API_KEY=

# Optional: Provide SMTP credentials for standard mail dispatch (Gmail, Outlook, Hostinger, cPanel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sender Identity & Admin Alert Destination
EMAIL_FROM="Pyda Movers <dispatch@pydamovers.com>"
ADMIN_NOTIFICATION_EMAIL="yerimaforfor@gmail.com"

# MAILCHIMP NEWSLETTER & MAILING LIST INTEGRATION (Optional)
# If provided, newly collected subscriber emails in the footer are automatically synced to Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=

# SMS NOTIFICATION GATEWAY (TWILIO / NIGERIAN CARRIER INTEGRATION)
# Optional: Provide Twilio credentials to dispatch real-time SMS alerts to customers
# when insurance policies are generated and ready in the Document Vault.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_SENDER_ID="PYDA"

